# Reddit API (optional – for authenticated voting/commenting)
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PeptideMarketplace/1.0

# The subreddit used for vendor discussion threads (without the r/ prefix)
NEXT_PUBLIC_REDDIT_SUBREDDIT=peptidemarket

# NextAuth (needed if you add Reddit OAuth login)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
