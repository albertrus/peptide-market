# Copy to .env.local. Nothing here is required to run the site; every value
# below either raises a rate limit, enables an optional source, or matters only
# in production.

# Raises the PubMed rate limit from 3 requests/sec to 10. Free, from
# https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Enables the community discussion panel. Reddit stopped serving its public
# JSON endpoints to unauthenticated server callers, so without these the panel
# renders its unavailable state. Create a "script" app at
# https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Sent to ClinicalTrials.gov and PubMed so the NIH can contact you about
# traffic instead of silently rate limiting. Set this once the site has a real
# domain and contact address.
RESEARCH_USER_AGENT=

# Required before deploying anywhere real. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
